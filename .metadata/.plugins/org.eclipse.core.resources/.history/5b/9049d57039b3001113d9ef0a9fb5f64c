#ifndef BME280_H
#define BME280_H

#include <stdint.h>
#include "stm32f4xx_hal.h"
#include "main.h"// TODO: adjust to your actual STM32 HAL family header

#ifdef __cplusplus
extern "C" {
#endif

/* ---- Register addresses (BME280 datasheet, chapter 5) ---- */
#define BME280_REG_CALIB00      0x88   /* dig_T1..dig_P9, calib00..calib25 (0x88-0xA1) */
#define BME280_REG_ID           0xD0
#define BME280_REG_RESET        0xE0
#define BME280_REG_CALIB26      0xE1   /* dig_H2..dig_H6 (0xE1-0xE7) */
#define BME280_REG_CTRL_HUM     0xF2
#define BME280_REG_STATUS       0xF3
#define BME280_REG_CTRL_MEAS    0xF4
#define BME280_REG_CONFIG       0xF5
#define BME280_REG_PRESS_MSB    0xF7   /* burst read start, 0xF7..0xFE (8 bytes) */

#define BME280_CHIP_ID          0x60
#define BME280_SOFT_RESET_CMD   0xB6

#define BME280_STATUS_MEASURING (1 << 3)
#define BME280_STATUS_IM_UPDATE (1 << 0)

/* ---- Oversampling settings (osrs_t / osrs_p / osrs_h), Table 20/23/24 ---- */
typedef enum {
    BME280_OSRS_SKIPPED = 0x00,
    BME280_OSRS_X1      = 0x01,
    BME280_OSRS_X2      = 0x02,
    BME280_OSRS_X4      = 0x03,
    BME280_OSRS_X8      = 0x04,
    BME280_OSRS_X16     = 0x05
} BME280_Oversampling_t;

/* ---- Sensor mode (mode[1:0]), Table 25 ---- */
typedef enum {
    BME280_MODE_SLEEP  = 0x00,
    BME280_MODE_FORCED = 0x01, /* 0x01 and 0x02 both map to forced mode */
    BME280_MODE_NORMAL = 0x03
} BME280_Mode_t;

/* ---- IIR filter coefficient (filter[2:0]), Table 28 ---- */
typedef enum {
    BME280_FILTER_OFF = 0x00,
    BME280_FILTER_2   = 0x01,
    BME280_FILTER_4   = 0x02,
    BME280_FILTER_8   = 0x03,
    BME280_FILTER_16  = 0x04
} BME280_Filter_t;

/* ---- Standby time in normal mode (t_sb[2:0]), Table 27 ---- */
typedef enum {
    BME280_STANDBY_0_5_MS  = 0x00,
    BME280_STANDBY_62_5_MS = 0x01,
    BME280_STANDBY_125_MS  = 0x02,
    BME280_STANDBY_250_MS  = 0x03,
    BME280_STANDBY_500_MS  = 0x04,
    BME280_STANDBY_1000_MS = 0x05,
    BME280_STANDBY_10_MS   = 0x06,
    BME280_STANDBY_20_MS   = 0x07
} BME280_Standby_t;

/* Factory trimming / calibration parameters, datasheet chapter 4.2.2, Table 16 */
typedef struct {
    uint16_t dig_T1;
    int16_t  dig_T2;
    int16_t  dig_T3;

    uint16_t dig_P1;
    int16_t  dig_P2;
    int16_t  dig_P3;
    int16_t  dig_P4;
    int16_t  dig_P5;
    int16_t  dig_P6;
    int16_t  dig_P7;
    int16_t  dig_P8;
    int16_t  dig_P9;
} BME280_CalibData_t;

typedef struct {
    int32_t temp_raw;   /* adc_T, 20-bit unsigned value in a 32-bit container */
    int32_t press_raw;  /* adc_P, 20-bit unsigned value in a 32-bit container */

    float temperature;  /* degC */
    float pressure;     /* Pa   */
} BME280_Data_t;

void BME280_Init(void);
void BME280_BurstReadData(uint8_t* buf);
void BME280_Extract_Data(BME280_Data_t* data);

uint8_t BME280_ReadReg(uint8_t reg_addr);
void    BME280_WriteReg(uint8_t reg_addr, uint8_t data);

#ifdef __cplusplus
}
#endif

#endif /* BME280_H */
