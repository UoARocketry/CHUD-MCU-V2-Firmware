#include "bmp585.h"
#include "ra02.h"
#include "adxl314.h"
#include "imu.h"
#include "gnss.h"


#define GRAVITY               1.0f
#define CONFIRM_SAMPLES       3
#define LIFTOFF_THRESHOLD_G   3.0f
#define BURNOUT_THRESHOLD_G   1.3f
#define BIAS_CALIB_SAMPLES    200
#define BACKUP_COAST_TIME_MS  8200
#define TASK_PERIOD_MS        10
typedef enum {
    STATE_PAD_IDLE,
    STATE_BOOST,
    STATE_COASTING,
    STATE_DROGUE_DESCENT,
    STATE_MAIN_DESCENT,
    STATE_LANDED
} FlightState;


static float    accel_bias        = 0.0f;
static float    velocity          = 0.0f;
static float    position          = 0.0f;
static float    previous_position = 0.0f;
static uint8_t  decreasing_count  = 0;
static FlightState state          = STATE_PAD_IDLE;
//static uint32_t burnout_timestamp_ms = 0;
float  latest_accel_z;



static void calibrate_accel_bias(void) {
    float sum = 0.0f;
    for (int i = 0; i < BIAS_CALIB_SAMPLES; i++) {
//        xSemaphoreTake(accelMutex, portMAX_DELAY);
        float reading = accel_data.z_g;
//        xSemaphoreGive(accelMutex);

        sum += reading;
        vTaskDelay(pdMS_TO_TICKS(TASK_PERIOD_MS));
    }
    accel_bias = (sum / BIAS_CALIB_SAMPLES) - GRAVITY;
}


void stateEstimateTask(void *argument)
{
	calibrate_accel_bias();
    for (;;)
    {
    	uint32_t tick = osKernelGetTickCount();

    	float net_accel = accel_data.z_g - accel_bias - GRAVITY;
    	float dt = TASK_PERIOD_MS / 1000.0f;

    	switch (state) {

    	        case STATE_PAD_IDLE:
    	            if (accel_data.z_g > GRAVITY + LIFTOFF_THRESHOLD_G) {
    	                state = STATE_BOOST;
    	                velocity = 0.0f;
    	                position = 0.0f;
    	                previous_position = 0.0f;
    	                decreasing_count = 0;
    	            }
    	            break;

    	        case STATE_BOOST:
    	            velocity += net_accel * dt;
    	            position += velocity * dt;

    	            if (accel_data.z_g < GRAVITY + (BURNOUT_THRESHOLD_G - 1.0f)) {
    	                state = STATE_COASTING;
//    	                burnout_timestamp_ms = now_ms;
    	            }
    	            break;

    	        case STATE_COASTING: {
    	            previous_position = position;
    	            velocity += net_accel * dt;
    	            position += velocity * dt;

    	            if (position < previous_position) {
    	                decreasing_count++;
    	            } else {
    	                decreasing_count = 0;
    	            }

    	            bool primary_trigger = (decreasing_count >= CONFIRM_SAMPLES);
//    	            bool backup_trigger  = (now_ms - burnout_timestamp_ms) >= BACKUP_COAST_TIME_MS;
//
//    	            if (is_armed() && (primary_trigger || backup_trigger)) {
////    	                fire_drogue();
//    	                state = STATE_DROGUE_DESCENT;
//    	            }

    	            if (is_armed() && (primary_trigger)) {
    	            	//    	                fire_drogue();
    	            	state = STATE_DROGUE_DESCENT;
    	            }

    	            break;
    	        }

    	        case STATE_DROGUE_DESCENT:
    	        case STATE_MAIN_DESCENT:
    	        case STATE_LANDED:
    	            // main-deploy handled elsewhere (e.g. fixed delay after drogue)
    	            break;
    	        }

    	tick += TASK_PERIOD_MS;
    	osDelayUntil(tick);;
    }
}
