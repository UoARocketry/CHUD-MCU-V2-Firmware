#include "bme280.h"
#include <stdio.h>

// External handles generated by STM32CubeMX in main.c
extern SPI_HandleTypeDef hspi1;

// BME280 Register Addresses
#define BME280_REG_ID   0xD0
#define BME280_REG_CTRL 0xF4
#define BME280_REG_DATA 0xF7
#define BME280_REG_CONFIG 0xF5

// Calibration variables
static uint16_t dig_T1;
static int16_t  dig_T2, dig_T3;
static uint16_t dig_P1;
static int16_t  dig_P2, dig_P3, dig_P4, dig_P5, dig_P6, dig_P7, dig_P8, dig_P9;

static int32_t t_fine; // Global variable required for pressure compensation

// Private function prototypes
static uint8_t readRegister(uint8_t regAddr);
static void writeRegister(uint8_t regAddr, uint8_t data);
static void readMultiByte(uint8_t regAddr, uint8_t* buffer, uint16_t length);
static void readCalibrationData(void);
static int32_t compensateTemperature(int32_t adc_T);
static uint32_t compensatePressure(int32_t adc_P);

/**
 * @brief  Initializes the BME280 sensor over SPI1, checks ID, and loads calibration data.
 */
void BME280_Init(void) {
  printf("BME280 SPI Initializing on STM32F411...\r\n");

  // Verify Chip ID (Should return 0x60)
  uint8_t chipId = readRegister(BME280_REG_ID);
  printf("BME280 Chip ID Read: 0x%02X\r\n", chipId);

  if (chipId == 0x60) {
    printf("Success: BME280 chip detected correctly!\r\n");
  } else {
    printf("Error: Unexpected Chip ID. Check wiring and SPI settings.\r\n");
  }

  // Read calibration parameters from the sensor memory
  readCalibrationData();

  // config: t_sb=000 (0.5ms standby), filter=010 (IIR coeff 4), spi3w_en=0
  writeRegister(BME280_REG_CONFIG, 0x08);

  // Configure sensor: normal mode, temperature oversampling = 1, pressure oversampling = 1
  writeRegister(BME280_REG_CTRL, 0x27);
  HAL_Delay(50);
}

/**
 * @brief  Reads raw sensor data, applies compensation formulas, and populates the struct.
 */
void BME280_Extract_Data(BME280_Data_t *data) {
  uint8_t raw_data[6];

  // Read 6 bytes starting from 0xF7 (Pressure MSB, LSB, XLSB & Temp MSB, LSB, XLSB)
  readMultiByte(BME280_REG_DATA, raw_data, 6);

  // Combine bytes into raw 20-bit values
  int32_t press_raw = ((int32_t)raw_data[0] << 12) | ((int32_t)raw_data[1] << 4) | ((int32_t)raw_data[2] >> 4);
  int32_t temp_raw  = ((int32_t)raw_data[3] << 12) | ((int32_t)raw_data[4] << 4) | ((int32_t)raw_data[5] >> 4);

  // Compensate temperature and pressure using factory calibration
  int32_t temp_calibrated = compensateTemperature(temp_raw);
  uint32_t press_calibrated = compensatePressure(press_raw);

  // Convert fixed-point results into readable units
  data->temperature = (float)temp_calibrated / 100.0f;       // °C
  data->pressure    = (float)press_calibrated / 256.0f ; // Pa
}

// --- SPI Communication Helpers using HAL ---

static uint8_t readRegister(uint8_t regAddr) {
  uint8_t txData = regAddr | 0x80; // Read command: Bit 7 is '1'
  uint8_t rxData = 0;

  HAL_GPIO_WritePin(BMP_CS_GPIO_Port, BMP_CS_Pin, GPIO_PIN_RESET);
  HAL_SPI_Transmit(&hspi1, &txData, 1, HAL_MAX_DELAY);
  HAL_SPI_Receive(&hspi1, &rxData, 1, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(BMP_CS_GPIO_Port, BMP_CS_Pin, GPIO_PIN_SET);

  return rxData;
}

static void writeRegister(uint8_t regAddr, uint8_t data) {
  uint8_t txData[2];
  txData[0] = regAddr & 0x7F; // Write command: Bit 7 is '0'
  txData[1] = data;

  HAL_GPIO_WritePin(BMP_CS_GPIO_Port, BMP_CS_Pin, GPIO_PIN_RESET);
  HAL_SPI_Transmit(&hspi1, txData, 2, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(BMP_CS_GPIO_Port, BMP_CS_Pin, GPIO_PIN_SET);
}

static void readMultiByte(uint8_t regAddr, uint8_t* buffer, uint16_t length) {
  uint8_t txData = regAddr | 0x80;

  HAL_GPIO_WritePin(BMP_CS_GPIO_Port, BMP_CS_Pin, GPIO_PIN_RESET);
  HAL_SPI_Transmit(&hspi1, &txData, 1, HAL_MAX_DELAY);
  HAL_SPI_Receive(&hspi1, buffer, length, HAL_MAX_DELAY);
  HAL_GPIO_WritePin(BMP_CS_GPIO_Port, BMP_CS_Pin, GPIO_PIN_SET);
}

// --- Calibration Data Reader ---

static void readCalibrationData(void) {
  dig_T1 = (uint16_t)readRegister(0x89) << 8 | readRegister(0x88);
  dig_T2 = (int16_t)readRegister(0x8B) << 8 | readRegister(0x8A);
  dig_T3 = (int16_t)readRegister(0x8D) << 8 | readRegister(0x8C);

  dig_P1 = (uint16_t)readRegister(0x8F) << 8 | readRegister(0x8E);
  dig_P2 = (int16_t)readRegister(0x91) << 8 | readRegister(0x90);
  dig_P3 = (int16_t)readRegister(0x93) << 8 | readRegister(0x92);
  dig_P4 = (int16_t)readRegister(0x95) << 8 | readRegister(0x94);
  dig_P5 = (int16_t)readRegister(0x97) << 8 | readRegister(0x96);
  dig_P6 = (int16_t)readRegister(0x99) << 8 | readRegister(0x98);
  dig_P7 = (int16_t)readRegister(0x9B) << 8 | readRegister(0x9A);
  dig_P8 = (int16_t)readRegister(0x9D) << 8 | readRegister(0x9C);
  dig_P9 = (int16_t)readRegister(0x9F) << 8 | readRegister(0x9E);
}

// --- Official Bosch Compensation Algorithms ---

static int32_t compensateTemperature(int32_t adc_T) {
  int32_t var1, var2, T;
  var1 = (((adc_T >> 3) - ((int32_t)dig_T1 << 1))) * ((int32_t)dig_T2) >> 11;
  var2 = (((((adc_T >> 4) - ((int32_t)dig_T1)) * ((adc_T >> 4) - ((int32_t)dig_T1))) >> 12) * ((int32_t)dig_T3)) >> 14;
  t_fine = var1 + var2;
  T = (t_fine * 5 + 128) >> 8;
  return T;
}

static uint32_t compensatePressure(int32_t adc_P) {
  int64_t var1, var2, p;
  var1 = ((int64_t)t_fine) - 128000;
  var2 = var1 * var1 * (int64_t)dig_P6;
  var2 = var2 + ((var1 * (int64_t)dig_P5) << 17);
  var2 = var2 + (((int64_t)dig_P4) << 35);
  var1 = ((var1 * var1 * (int64_t)dig_P3) >> 8) + ((var1 * (int64_t)dig_P2) << 12);
  var1 = (((int64_t)1 << 47) + var1) * ((int64_t)dig_P1) >> 33;

  if (var1 == 0) {
    return 0;
  }

  p = 1048576 - adc_P;
  p = (((p << 31) - var2) * 3125) / var1;
  var1 = (((int64_t)dig_P9) * (p >> 13) * (p >> 13)) >> 25;
  var2 = (((int64_t)dig_P8) * p) >> 19;
  p = ((p + var1 + var2) >> 8) + (((int64_t)dig_P7) << 4);
  return (uint32_t)p;
}
